[Unit]
Description=Codex app-server for SSH-forwarded Linux remote TUI
Documentation=https://learn.chatgpt.com/docs/app-server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
Environment=CODEX_HOME=/root/.codex
WorkingDirectory=/root/ClaudeCompany
ExecStart=/usr/local/bin/codex app-server --listen ws://127.0.0.1:4500
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
