#!/usr/sbin/nft -f
# 봇 egress 통제 (2026-07-30, 현준-4)
#
# 왜: 봇이 임의 IP로 작품 파일을 내보낼 수 있었다(실측: 외부 IP 301, POST 통함). 판별 uid가
# 생기기 전에는 러너와 봇이 같은 계정이라 봇만 가릴 수 없었다 — 러너 자신은 모델 API로 나가야
# 하므로 계정을 막으면 러너가 죽는다. 이제 봇은 300000번대이므로 봇만 막을 수 있다.
#
# 범위를 좁게 잡는다: 봇 uid 범위에만 규칙을 걸고 그 밖은 손대지 않는다(policy accept).
# 잘못돼도 프로덕션·러너·세션은 영향받지 않는다.
#
# 봇에게 남기는 길:
#   · loopback — 자기 판이 띄운 개발 서버 검증(실측: run curl 목적지의 최다 항목)과 관문
#   · 그 외 외부는 전부 거부 → 나가려면 관문(127.0.0.1:8118)의 허용 목록을 통과해야 한다
#
# 되돌리기:  nft delete table inet organt_egress

table inet organt_egress {
    # 봇이 닿으면 안 되는 내부 서비스 포트. 새 내부 서비스를 띄우면 여기에 더한다.
    #   5432 postgres · 8000 gunicorn(murmur-web) · 8002 uvicorn(sse)
    #   8080 nginx(내부) · 8100 python3(voice)
    # 8118(tinyproxy 관문)은 일부러 뺀다 — 봇의 유일한 바깥길이다.
    set internal_ports {
        type inet_service
        # 22: 이 서버 SSH. 봇이 자기 판 밖으로 나갈 이유가 없고, 자격증명이 없어도
        #     붙을 수 있다는 것 자체가 표면이다(무차별 시도·설정 실수).
        elements = { 22, 5432, 8000, 8002, 8080, 8100 }
    }

    chain output {
        type filter hook output priority 0; policy accept;

        # 봇이 아닌 트래픽은 즉시 통과 — 러너(999)·웹(root)·세션(dojin)은 규칙 대상이 아니다.
        meta skuid < 300000 accept
        meta skuid > 300999 accept

        # 여기부터는 봇(300000-300999)만 온다.

        # [내부 서비스 봉인(2026-07-31, 현준-4 실측)] loopback을 통째로 열어두니 봇이
        # 데이터베이스(5432)와 내부 API(8000)에 그대로 닿았다. 실측: DB 연결 성립,
        # murmur-web 200. 인증은 서 있지만(guide 종단 403, pg는 scram) 봇이 이것들에
        # 닿을 이유가 없다 — 자격증명이 한 번 새면 곧바로 실행 가능한 공격이 된다.
        # 문자열 거부 목록(/api/guide 등)은 명령 겉모습만 보므로 우회된다.
        #
        # 이 포트들은 이미 시스템 서비스가 점유하고 있어 봇이 자기 서버를 띄울 수도
        # 없다 — 막아도 봇의 정상 작업에는 값이 없다. 관문(8118)은 목록에 없어 살아 있다.
        # 목적지를 가리지 않는다. 종전엔 127.0.0.0/8만 걸렀는데, 자기 LAN 주소로 가는
        # 트래픽은 커널이 loopback으로 흘려서 그 뒤 'oif lo accept'에 걸려 통과했다 —
        # 실측: 봇이 192.168.0.5:22(이 서버 SSH)에 연결됐다. 포트로만 막으면 경로가
        # 무엇이든 같은 답이 나온다.
        tcp dport @internal_ports reject with icmpx type admin-prohibited

        oif "lo" accept
        ip daddr 127.0.0.0/8 accept
        ip6 daddr ::1 accept

        # 이미 맺어진 연결은 유지(관문 경유 응답 등).
        ct state established,related accept

        # 나머지 외부는 거부한다. drop이 아니라 reject — 봇이 '막혔다'를 즉시 알아야
        # 타임아웃으로 오래 매달리지 않고, 그래서 원인을 사람에게 보고할 수 있다.
        reject with icmpx type admin-prohibited
    }
}
