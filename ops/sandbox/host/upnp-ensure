#!/bin/bash
# UPnP 포트 매핑 자동 유지 (2026-07-31, 현준-4)
#
# 왜: 공유기가 재시작하면 UPnP 매핑이 통째로 사라진다. 실측으로 07-30 22:53 WAN 재시작 때
# 그렇게 murmur가 밖에서 끊겼고, 사람이 알아채기까지 한 시간 넘게 걸렸다. 관리 화면의 정적
# 포워딩이 근본 해결이지만 그건 사람 손이 필요하다 — 그때까지 스스로 되살아나게 한다.
#
# 재부팅만이 아니라 주기적으로 확인한다. 끊긴 사례가 '공유기 재시작'이지 '이 서버 재부팅'이
# 아니었기 때문이다 — 부팅 때만 걸면 그 사고를 못 막는다.
#
# 되돌리기: systemctl disable --now upnp-ensure.timer
set -u

PORTS="${UPNP_PORTS:-80 443}"
LOG="/var/log/upnp-ensure.log"

# 랜 주소를 박지 않는다 — DHCP로 바뀌면 엉뚱한 곳에 매핑이 걸린다.
LAN="$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[\d.]+' | head -1)"
[ -n "$LAN" ] || { echo "$(date -Is) 랜 주소를 못 찾음 — 건너뜀" >> "$LOG"; exit 0; }

MAP="$(timeout 25 upnpc -l 2>/dev/null)" || MAP=""
[ -n "$MAP" ] || { echo "$(date -Is) 공유기 응답 없음 — 건너뜀" >> "$LOG"; exit 0; }

added=0
for p in $PORTS; do
  # 이 포트가 이 서버로 이미 걸려 있으면 건드리지 않는다(멱등).
  if echo "$MAP" | grep -qE "TCP +${p}->${LAN}:${p}"; then
    continue
  fi
  if timeout 25 upnpc -a "$LAN" "$p" "$p" TCP 0 >/dev/null 2>&1; then
    echo "$(date -Is) 매핑 재등록 ${p} -> ${LAN}:${p}" >> "$LOG"
    added=$((added + 1))
  else
    echo "$(date -Is) 매핑 실패 ${p} -> ${LAN}:${p}" >> "$LOG"
  fi
done

# 조용한 성공은 기록하지 않는다 — 5분마다 도는 것이라 로그가 사실을 덮는다.
[ "$added" -gt 0 ] && echo "$(date -Is) 매핑 ${added}건 재등록" >> "$LOG"

# [실제 도달 확인 2026-07-31] 매핑이 있다고 밖에서 열리는 것은 아니다. 07-30 사고 때
# 진짜 문제는 '끊긴 것'이 아니라 '한 시간 넘게 아무도 몰랐던 것'이었다 — 서버 안에서
# 보면 다 정상이라 내부 감시로는 안 잡힌다. 공인 주소로 실제로 두드려 본다.
# UPNP_PROBE_HOST로 대상을 바꿀 수 있다 - 경고 경로가 실제로 도는지 시험하기 위해서다.
# 시험할 수 없는 경보는 켜져 있다고 믿을 뿐 지켜 주지 않는다.
PUB="${UPNP_PROBE_HOST:-$(timeout 10 curl -s --max-time 8 https://api.ipify.org 2>/dev/null)}"
if [ -n "$PUB" ]; then
  CODE="$(timeout 15 curl -s -o /dev/null -w '%{http_code}' --max-time 12 -k \
          "https://${PUB}/" 2>/dev/null)"
  if [ "$CODE" = "000" ] || [ -z "$CODE" ]; then
    # 경고는 journal로도 낸다 — 로그 파일만 쓰면 아무도 안 본다.
    echo "$(date -Is) 밖에서 안 열린다(공인 ${PUB} 응답 ${CODE:-없음}) — 매핑 재등록 시도함" >> "$LOG"
    echo "외부 도달 실패: https://${PUB}/ 응답 ${CODE:-없음}" >&2
    exit 1                      # 실패로 끝내야 systemd가 실패로 기록한다
  fi
fi
exit 0
